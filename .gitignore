node_modules/
dist/

# 一次性诊断脚本与结果（.ego-tmp-*.mjs / *.json），收工后可清，不提交
.ego-tmp-*

# 临时构建目录、日志、进度文件（.tmp-dist-* / .tmp-*.log / .tmp-*.json），收工后可清，不提交
.tmp-*

# 站点发布用的纯静态副本（由 dist 复制，不进版本库）
.site-publish/

# 以下为证据留档，禁止加入忽略：
#   docs/evidence/         验证截图与 metrics
#   docs/test-shots/       测试流程截图
#   docs/demo-video-*.mp4  交付视频
#   docs/demo-video-*.webm 视频中间源（保留，作为录制证据）

# 抽帧清理版与 docs/demo-frames-hd 同名重复（61 个 f-00xx.png），保留已入库的 demo-frames-hd 一份即可
docs/demo-frames-hd-clean/

# Agent 工具会话状态（扫描缓存 / 可视化桥），非项目内容
.mimosa/
.v2c/
.arts/

# Python 缓存
__pycache__/
*.pyc
# 部署分发包（可由 dist 重建，不入库）
docs/*.zip


# 内部自审报告与过期失败截图（仅供统一参考，不进提交仓库，避免与最终成果失配）
.review-internal/

# 构建验证副本（dist 的另一次构建，可由 npm run build 重建，不进版本库）
.verify-build/

# ZCode/Agent 工作流运行记录与状态，非项目内容
.zcode/

# 一次性诊断输出（js 侧探针结果，非证据留档）
docs/dodge-diag.json
docs/stat-verify.json
docs/perf-report.json

# 失败截图一律归档到 docs/evidence/iteration/，不进 docs/test-shots
docs/test-shots/*-FAIL.png

# 官方图生 3D 的原始大二进制（38.5MB GLB + 27.6MB OBJ zip）不入库：
# 可复现的交付资产是 public/asset/naiwa_hand_cursor.glb（压缩版 795KB）。
# 仅排除这两个文件；同目录 preview.png / 查看页 / model-viewer.min.js 仍作为证据留档。
docs/evidence/naiwa-hand-3d/naiwa_hand_cursor.glb
docs/evidence/naiwa-hand-3d/model_obj.zip

# 工作区会话状态（记忆与工具状态），非项目交付内容
.workbuddy/
.zwork/

# Aholo/Lux3D open-platform credentials (local only, never commit)
.lux3d-credentials.json
.lux3d-work/
